rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && userDoc().data.role == "admin"; }
    function isTeacher() { return signedIn() && userDoc().data.role == "teacher"; }
    function isStudent() { return signedIn() && userDoc().data.role == "student"; }
    function ownsStudent(studentId) { return isStudent() && userDoc().data.studentId == studentId; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }
    match /students/{studentId} {
      allow read: if isAdmin() || isTeacher() || ownsStudent(studentId);
      allow create, update, delete: if isAdmin();
    }
    match /teachers/{teacherId} {
      allow read: if isAdmin() || (isTeacher() && (request.auth.uid == teacherId || resource.data.authUid == request.auth.uid));
      allow create, update, delete: if isAdmin();
    }
    match /classes/{classId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /subjects/{subjectId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /attendance/{recordId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == userDoc().data.studentId) || isTeacher();
      allow create, update: if isAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /results/{resultId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == userDoc().data.studentId) || isTeacher();
      allow create, update: if isAdmin() || (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /fees/{feeId} {
      allow read: if isAdmin() || ownsStudent(resource.data.studentId);
      allow create, update, delete: if isAdmin();
    }
    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /promotionHistory/{promotionId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /studentHistory/{historyId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == userDoc().data.studentId);
      allow create, update, delete: if isAdmin();
    }
  }
}
